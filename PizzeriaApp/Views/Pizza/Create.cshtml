@model PizzaFormViewModel
@{
    ViewData["Title"] = "Dodaj nowa pizze";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Menu</a></li>
        <li class="breadcrumb-item active">Nowa pizza</li>
    </ol>
</nav>

<h2 class="mb-4">Dodaj nowa pizze</h2>

<div class="card shadow-sm" style="max-width:650px">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-bold"></label>
                <input asp-for="Name" class="form-control" placeholder="np. Margherita" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CrustType" class="form-label fw-bold"></label>
                <select asp-for="CrustType" class="form-select">
                    <option value="">-- Wybierz rodzaj ciasta --</option>
                    <option value="0">Cienkie</option>
                    <option value="1">Grube</option>
                </select>
                <span asp-validation-for="CrustType" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="PriceSmall" class="form-label fw-bold"></label>
                    <div class="input-group">
                        <input asp-for="PriceSmall" class="form-control" type="number" step="0.01" min="0.01" />
                        <span class="input-group-text">zl</span>
                    </div>
                    <span asp-validation-for="PriceSmall" class="text-danger small"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="PriceMedium" class="form-label fw-bold"></label>
                    <div class="input-group">
                        <input asp-for="PriceMedium" class="form-control" type="number" step="0.01" min="0.01" />
                        <span class="input-group-text">zl</span>
                    </div>
                    <span asp-validation-for="PriceMedium" class="text-danger small"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="PriceLarge" class="form-label fw-bold"></label>
                    <div class="input-group">
                        <input asp-for="PriceLarge" class="form-control" type="number" step="0.01" min="0.01" />
                        <span class="input-group-text">zl</span>
                    </div>
                    <span asp-validation-for="PriceLarge" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Skladniki</label>
                @if (!Model.AvailableIngredients.Any())
                {
                    <div class="alert alert-warning py-2">
                        Brak dostepnych skladnikow.
                        <a asp-controller="Ingredient" asp-action="Create">Dodaj skladniki</a> przed tworzeniem pizzy.
                    </div>
                }
                else
                {
                    <div class="border rounded p-3 d-flex flex-wrap gap-3 bg-white">
                        @foreach (var ingredient in Model.AvailableIngredients)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       name="SelectedIngredientIds" value="@ingredient.Id"
                                       id="ing_@ingredient.Id"
                                       @(Model.SelectedIngredientIds.Contains(ingredient.Id) ? "checked" : "") />
                                <label class="form-check-label" for="ing_@ingredient.Id">@ingredient.Name</label>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger px-4">Dodaj pizze</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        const vs = document.querySelector('[data-valmsg-summary]');
        if (vs && vs.querySelector('li')) vs.classList.remove('d-none');
    </script>
}
