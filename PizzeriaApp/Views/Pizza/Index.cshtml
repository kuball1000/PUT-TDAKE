@model IEnumerable<Pizza>
@{
    ViewData["Title"] = "Menu pizz";
    string? search = ViewBag.Search as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Menu pizz</h1>
    <a asp-action="Create" class="btn btn-danger">+ Dodaj pizze</a>
</div>

<form method="get" class="mb-4">
    <div class="input-group" style="max-width:400px">
        <input type="text" name="search" class="form-control" placeholder="Szukaj po nazwie..." value="@search" />
        <button type="submit" class="btn btn-outline-danger">Szukaj</button>
        @if (!string.IsNullOrEmpty(search))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Wyczysc</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">
        @if (!string.IsNullOrEmpty(search))
        {
            <span>Brak pizz pasujacych do "<strong>@search</strong>".</span>
        }
        else
        {
            <span>Brak pizz w menu. <a asp-action="Create">Dodaj pierwsza pizze!</a></span>
        }
    </div>
}
else
{
    <table class="table table-hover table-striped align-middle shadow-sm">
        <thead class="table-danger">
            <tr>
                <th>Nazwa</th>
                <th>Ciasto</th>
                <th>Cena M / S / D</th>
                <th>Skladniki</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pizza in Model)
            {
                <tr>
                    <td><strong>@pizza.Name</strong></td>
                    <td>@(pizza.CrustType == CrustType.Thin ? "Cienkie" : "Grube")</td>
                    <td>@pizza.PriceSmall.ToString("F2") / @pizza.PriceMedium.ToString("F2") / @pizza.PriceLarge.ToString("F2") zl</td>
                    <td>
                        @if (pizza.PizzaIngredients.Any())
                        {
                            <span>@string.Join(", ", pizza.PizzaIngredients.Select(pi => pi.Ingredient.Name))</span>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">brak</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@pizza.Id" class="btn btn-sm btn-outline-dark">Szczegoly</a>
                        <a asp-action="Delete" asp-route-id="@pizza.Id" class="btn btn-sm btn-outline-danger">Usun</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
